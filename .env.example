# Copiar a ".env" y rellenar con valores reales.
# NUNCA commitear el archivo ".env" real (ver .gitignore).

# ============================================================================
# SUPABASE (base de datos de producción / pruebas)
# Rellenar con las credenciales del proyecto Supabase y usar:
#   docker compose -f docker-compose.supabase.yml up -d --build
# ============================================================================
# Host de conexión (Render > Supabase):
#   - OJO: "Direct connection" (db.<ref>.supabase.co) solo resuelve por IPv6 y
#     Render no tiene salida IPv6. Usa el POOLER (IPv4) del dashboard
#     (Connect > Connection pooling): aws-1-<region>.pooler.supabase.com
#   - Puerto 5432 = session mode (recomendado: soporta migraciones EF Core)
#   - Puerto 6543 = transaction mode
#   - En el pooler el usuario lleva el project-ref: postgres.<project-ref>
#
# NOTA: host, puerto, base y usuario NO son secretos y ya tienen valores por
# defecto en MimaCare.Presentation/appsettings.json (sección "Supabase").
# Estas variables son solo para SOBRESCRIBIR esos valores.
SUPABASE_DB_HOST=aws-1-<region>.pooler.supabase.com
SUPABASE_DB_PORT=5432
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=postgres.<project-ref>
# Único secreto obligatorio en producción:
SUPABASE_DB_PASSWORD=
# JWT Secret (Dashboard > Settings > API > JWT Secret) -> se usa como Jwt:Key
SUPABASE_JWT_SECRET=
# Opcionales: proyecto y anon key (para integrar SDK en el futuro)
SUPABASE_PROJECT_URL=
SUPABASE_ANON_KEY=

# ============================================================================
# POSTGRESQL LOCAL EN DOCKER (solo para desarrollo con docker-compose.yml)
# ============================================================================
POSTGRES_DB=MimaCare
POSTGRES_USER=postgres
POSTGRES_PASSWORD=cambia_esta_password
# Host/puerto internos de la red de Docker (no tocar normalmente)
POSTGRES_HOST=db
POSTGRES_PORT=5432
# Puerto que expone PostgreSQL en tu máquina (si ya tienes Postgres local usa 5433)
POSTGRES_PORT_EXTERNO=5433

# ============================================================================
# API
# ============================================================================
API_PORT=5097
ASPNETCORE_ENVIRONMENT=Development

# Clave de firma del JWT para el modo local (si se usa docker-compose.supabase.yml
# con SUPABASE_JWT_SECRET, esta no se usa)
JWT_KEY=cambia_esta_clave_jwt