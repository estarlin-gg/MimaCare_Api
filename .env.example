# Copiar a ".env" y rellenar con valores reales.
# NUNCA commitear el archivo ".env" real (ver .gitignore).

# PostgreSQL (contenedor)
POSTGRES_DB=MimaCare
POSTGRES_USER=postgres
POSTGRES_PASSWORD=cambia_esta_password
# Host/puerto internos de la red de Docker (no tocar normalmente)
POSTGRES_HOST=db
POSTGRES_PORT=5432
# Puerto que expone PostgreSQL en tu máquina (si ya tienes Postgres local usa 5433)
POSTGRES_PORT_EXTERNO=5433

# API
API_PORT=5097
ASPNETCORE_ENVIRONMENT=Development

# Clave de firma del JWT (cambiar por una segura, min 32 chars recomendado)
JWT_KEY=cambia_esta_clave_jwt